// Cocos Creator 3.8 Sprite shader —— 领地「翻开随机资源格」的**原地快碎裂**。
//
// 2026-10-16 用户口径：两个方案里**只保留「地块破碎」那套** ⇒ 本材质只剩片元级的碎块腐蚀 +
// 起手白闪。原先服务另一套方案（抬起后绕水平轴垂直翻转 360°）的东西已全部删除，它们在
// `core/hex/HexFlipPresentation` 里也一并删了（`hexTurnFx` 等，见那边的模块头注释）：
//   · 顶点层：绕格心的真 3D 旋转 + 透视除法（`flipCos` / `flipSin` / `flipPerspective`）；
//   · 片元层：按旋转深度的体积明暗（`vDepth` / `vTurn`）；
//   · 收尾层：接近侧视时整格淡出（`turnParams.x` / `vCos`）；
//   · 补光层：正面开口的轻微补光（`glowStrength` / `vLocalY`）。
// 🔴 这些删除都是**逐像素等价**的，因为碎裂曲线全程 `tileFlip(cos) = 1` 且 `tileLift = 0`：
//    旋转角 0 ⇒ 透视因子 `q ≡ 1`（顶点不动）；`abs(sin) = 0` ⇒ `mix(1, shade, 0) ≡ 1`；
//    补光强度由 `tileLift` 归一化 ⇒ 恒 0；`smoothstep(0, t, |cos|) ≡ 1` ⇒ 不淡。
//    ⚠️ 别只把曲线补回来（顶点/片元这几段已经不在了，翻整圈会退化成纯压扁）；
//       要回看旧实现走版本历史（SVN）。
//
// ## 碎裂怎么做的
// 整格只有 **4 个顶点**，按碎块分别位移做不到（那需要每块自己的四边形），所以碎裂全在**片元**做：
//  · **碎块划分**：把格内归一化坐标 `vQuad`（-1..1）映射到 `shardGrid` 的网格里，用经典
//    Voronoi 取「最近的抖动种子」（3×3 邻域），碎块因此大小 / 朝向都不规则（不抖动会像瓷砖）；
//    ⚠️ `vQuad` 必须由**世界坐标 ÷ 实际半尺寸**得到，**不能用 `a_texCoord`**
//    （SpriteFrame 可能是裁剪过 / 打进图集的，UV 只覆盖裁剪框）；
//  · **腐蚀**：`border = 到第二近种子的距离 - 到最近种子的距离`，就是「离碎块边界多远」；
//    进度越大要求的 `border` 越大 ⇒ 碎块**从边缘往中心缩没**。每个碎块按自己的哈希取延迟
//    ⇒ 错峰碎裂（不是整体一起化掉）；
//  · **裂缝**：`|border - 阈值|` 很小的一薄圈提亮 —— 先看到裂缝，再看到块消失；
//  · **白闪**：起手 `flashParams.x` 把整格朝白推一下（曲线给的是 0 → 峰值 → 0）。
// `shatterParams.x = 0` 时整段跳过 ⇒ 逐像素等价于「没有碎裂」（起手那几帧与静止态都走这条）。
//
// ⚠️ 碎块遮罩在**片元最后**统一乘上去：补光 / 明暗那几段（已删）原本是加法项，
//    先加后乘才不会在「已经碎掉」的位置留下残亮；裂缝亮线是唯一**乘完再加**的，
//    否则它自己会被碎块遮罩抹掉（它就长在遮罩的边缘上）。
//
// ⚠️ 适用范围（2026-10-16 起）：**只剩领地地图的随机资源格翻开在用**（`TerritoryHexFlip`）。
//    别把它接回 `ZCHexView` —— 对局地块是合批的，挂上自定义材质会整格退出合批；
//    对局的收场是「原地脉冲呼吸 + 原地缩没」，不挂这份材质。
CCEffect %{
  techniques:
  - passes:
    - vert: hex-flip-vs:vert
      frag: hex-flip-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        flipCenter: { value: [0.0, 0.0] }
        flipHalfHeight: { value: 59.5 }
        flipHalfWidth: { value: 63.0 }
        flashParams: { value: [0, 0, 0, 0] }
        shatterParams: { value: [0, 0, 0, 0] }
        shardGrid: { value: [4, 4, 0, 0] }
}%

CCProgram hex-flip-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 frameUV;
  out vec4 color;
  out vec2 vQuad;    // 格内归一化坐标（-1..1）：碎裂的碎块划分用它，**不能用 a_texCoord**
                     // （SpriteFrame 可能是裁剪过 / 打进图集的，UV 只覆盖裁剪框）

  uniform HexFlip {
    vec2 flipCenter;       // 格心世界坐标（渲染层每帧写）
    float flipHalfHeight;  // 地块半高（**世界单位**，由格子的实际 UITransform 尺寸派生）
    float flipHalfWidth;   // 地块半宽（同上，世界单位）
    vec4 flashParams;      // x = 起手白闪强度 0~1
    vec4 shatterParams;    // x = 碎裂开关(0/1) y = 进度 0~1 z = 随机种子 w = 碎块中心抖动
    vec4 shardGrid;        // x = 碎块列数 y = 行数（zw 保留）
  };

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    // 顶点**不做任何形变**（碎裂是「原地」的）：这里只把顶点换算到「以格心为原点、按实际半尺寸
    // 归一化」的格内坐标系，送给片元去划分碎块。
    float lx = pos.x - flipCenter.x;
    float ly = pos.y - flipCenter.y;
    float hh = max(flipHalfHeight, 0.0001);
    float hw = max(flipHalfWidth, 0.0001);
    float u = clamp(ly / hh, -1.0, 1.0);  // 归一化高度：顶部 +1、底部 -1

    pos = cc_matViewProj * pos;
    frameUV = a_texCoord;
    color = a_color;
    vQuad = vec2(clamp(lx / hw, -1.0, 1.0), u);
    return pos;
  }
}%

CCProgram hex-flip-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec2 frameUV;
  in vec4 color;
  in vec2 vQuad;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform HexFlip {
    vec2 flipCenter;       // 格心世界坐标（渲染层每帧写）
    float flipHalfHeight;  // 地块半高（**世界单位**，由格子的实际 UITransform 尺寸派生）
    float flipHalfWidth;   // 地块半宽（同上，世界单位）
    vec4 flashParams;      // x = 起手白闪强度 0~1
    vec4 shatterParams;    // x = 碎裂开关(0/1) y = 进度 0~1 z = 随机种子 w = 碎块中心抖动
    vec4 shardGrid;        // x = 碎块列数 y = 行数（zw 保留）
  };

  /** 一维哈希（碎块种子 / 延迟）：输入同一个格子索引必须得到同一个值。 */
  float shardHash (vec2 cell) {
    return fract(sin(dot(cell, vec2(127.1, 311.7))) * 43758.5453123);
  }

  vec4 frag () {
    vec4 texel = CCSampleWithAlphaSeparated(cc_spriteTexture, frameUV);
    vec4 result = texel;
    // 与内置 sprite 同口径：sprite.color 照常参与（地块的阵营染色 / 去色图都靠它）。
    result *= color;

    // ---- 起手白闪：整格朝白推一下再退掉；曲线给的就是 0 → 峰值 → 0 ----
    float flash = clamp(flashParams.x, 0.0, 1.0);
    result.rgb = mix(result.rgb, vec3(1.0), flash);
    result.a = min(1.0, result.a + flash * texel.a * 0.35);

    // ---- 原地碎裂（碎块腐蚀 + 裂缝）----
    // `shatterParams.x = 0` 时整段不生效 ⇒ 逐像素等价于「没有碎裂」。
    float shardMask = 1.0;
    float seam = 0.0;
    if (shatterParams.x > 0.5) {
      vec2 grid = max(shardGrid.xy, vec2(1.0));
      vec2 cell = (vQuad * 0.5 + 0.5) * grid;
      vec2 base = floor(cell);
      // Voronoi：3×3 邻域里找最近 / 次近的抖动种子。`border` = 到碎块边界的距离。
      float d1 = 8.0;
      float d2 = 8.0;
      vec2 owner = base;
      for (int oy = -1; oy <= 1; oy += 1) {
        for (int ox = -1; ox <= 1; ox += 1) {
          vec2 idx = base + vec2(float(ox), float(oy));
          vec2 seed = idx + 0.5 + (vec2(shardHash(idx + shatterParams.z),
                                        shardHash(idx + shatterParams.z + 19.19)) - 0.5) * shatterParams.w;
          float d = distance(cell, seed);
          if (d < d1) { d2 = d1; d1 = d; owner = idx; }
          else if (d < d2) { d2 = d; }
        }
      }
      float border = d2 - d1;
      // 每个碎块自己的延迟（0~0.5）⇒ 错峰碎裂；进度按「剩下多少时间」归一化，保证最后一块也碎完。
      float delay = shardHash(owner + shatterParams.z + 37.7) * 0.5;
      float p = clamp((shatterParams.y - delay) / max(0.05, 1.0 - delay), 0.0, 1.0);
      p = p * p * (3.0 - 2.0 * p);
      // 阈值随进度往块心推：`1.3` 保证进度到 1 时连块心（border 最小处）也盖过去。
      float edge = border - p * 1.3;
      shardMask = smoothstep(0.0, 0.06, edge);
      seam = 1.0 - smoothstep(0.0, 0.10, abs(edge));
    }

    // ---- 统一收尾：先乘遮罩，再加裂缝亮线 ----
    result *= shardMask;
    // 裂缝：`border ≈ 阈值` 的薄圈提亮，必须**乘完遮罩之后**加（它就长在遮罩边缘上，
    // 先加会被自己那圈 `shardMask < 1` 抹掉）。用贴图原始 alpha 兜住轮廓，避免溢到格形之外。
    result.rgb += mix(color.rgb, vec3(1.0), 0.65) * seam;
    result.a = min(1.0, result.a + seam * texel.a * 0.6);
    return result;
  }
}%
